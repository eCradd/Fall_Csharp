<Window x:Class="WPF_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Project"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock x:Name="FirstName" HorizontalAlignment="Left" Margin="55,87,0,0" TextWrapping="Wrap" Text="First Name:" VerticalAlignment="Top"/>
        <TextBlock x:Name="LastName" HorizontalAlignment="Left" Margin="55,166,0,0" TextWrapping="Wrap" Text="Last Name:" VerticalAlignment="Top"/>
        <TextBlock x:Name="HoursWorked" HorizontalAlignment="Left" Margin="55,242,0,0" TextWrapping="Wrap" Text="Hours Worked:" VerticalAlignment="Top"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="-6,-10,-6,10">
            <TextBox x:Name="FirstNameBox" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Margin="59,120,0,0" TextChanged="FirstNameBox_TextChanged">
                <TextBox.Effect>
                    <DropShadowEffect/>
                </TextBox.Effect>
            </TextBox>

        </Border>
        <TextBox x:Name="LastNameBox" HorizontalAlignment="Left" Margin="55,187,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="LastNameBox_TextChanged">
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <TextBox x:Name="HoursWorkedBox" HorizontalAlignment="Left" Margin="55,263,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="HoursWorkedBox_TextChanged">
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <Button x:Name="SummarizeButton" Content="Summarize" HorizontalAlignment="Left" Margin="250,176,0,0" VerticalAlignment="Top" Click="SummarizeButton_Click" Height="41" Width="91"/>
        <Button x:Name="ClearButton" Content="Clear" HorizontalAlignment="Left" Margin="53,312,0,0" VerticalAlignment="Top" Click="ClearButton_Click"/>
        <TextBox x:Name="SummaryBox" HorizontalAlignment="Left" Margin="421,166,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="286" TextChanged="LastNameBox_TextChanged" Height="67">
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <Label x:Name="OutputLabel" Content="Summary&#xD;&#xA;" HorizontalAlignment="Left" Margin="421,132,0,0" VerticalAlignment="Top" Height="29"/>

    </Grid>
</Window>
