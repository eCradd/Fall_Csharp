<Window x:Class="Excersice1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Excersice1"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="MainWindow" Height="450" Width="800">
    
    <Window.Resources>
        <local:PersonClass x:Name="Person1" x:Key="Person1" Name="John Man" Age="30" />
    </Window.Resources>
    <Grid>
        <!-- creating a stack panel to hold the label and button -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- displaying the person label -->
            <Label x:Name="personLabel" 
                   HorizontalAlignment="Center" 
                   FontSize="18"
                   Margin="0,0,0,30"/> <!-- playing around with a margin -->
            <!-- the button!!! -->
            <Button Padding="20,10" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/OrangeBtn.png" Width="32" Height="32" Margin="0,0,10,0"/>
                    <Label VerticalAlignment="Center" FontSize="16" FontWeight="Bold">_Save Name</Label>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Window>
