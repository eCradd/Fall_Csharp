<Window x:Class="MultiWindowWPF.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiWindowWPF"
        mc:Ignorable="d"
        Title="EditWindow" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Canvas>
            <!-- Inputs -->

            <!-- First Name-->
            <Label Content="_First Name: " Target="{Binding ElementName=TxtFirstName}" />
            <TextBox x:Name="TxtFirstName" Width="120" Canvas.Left="20" Canvas.Top="45"/>
            <!-- Last Name-->
            <Label Content="_Last Name:" Target="{Binding ElementName=TxtLastName}" Canvas.Left="160" Canvas.Top="20"/>
            <TextBox x:Name="TxtLastName" Width="120" Canvas.Left="160" Canvas.Top="45"/>
            <!--Age-->
            <Label Content="_Age:" Target="{Binding ElementName=TxtAge}" Canvas.Left="20" Canvas.Top="80"/>
            <TextBox x:Name="TxtAge" Width="80" Canvas.Left="20" Canvas.Top="105"/>
        </Canvas>
        
        <!--BUTON!-->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Margin="0,0,20,20">
                
                <Button x:Name="BtnOk" Click="BtnOk_Click" IsDefault="True" Width="85" Height="28" Padding="5" Margin="0,0,10,0">
                    <AccessText Text="O_K"/>
                </Button>
                <Button x:Name="BtnCancel" Click="BtnCancel_Click" IsCancel="True" Width="85" Height="26" Padding="5">
                    <AccessText Text="Cancel"/>



                </Button>
            </StackPanel>

        
    </Grid>
</Window>
