<Window x:Class="DBExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DBExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Label Content="Text Box 1:" />
            <TextBox x:Name="txt1" Width="200" Margin="0,5" 
                     Text="{Binding ElementName=txt2 ,Path=Text, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Text Box 2:" />
            <TextBox x:Name="txt2" Width="200" Margin="0,5"
                     Text="{Binding ElementName=txt1, Path=Text, UpdateSourceTrigger=PropertyChanged}"/>
            
            <Button Content="Show Text" Width="100" Margin="0,10" Click="BtnShowText_Click"/>
            <Button Content="Set BoundText Programmatically" Width="199" Margin="0,5" Click="BtnSetText_Click"/>

        </StackPanel>
    </Grid>
</Window>
